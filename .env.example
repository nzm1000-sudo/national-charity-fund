# ============================================================
# הקופה הלאומית — Environment variables
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="הקופה הלאומית"

# --- Database (dev: SQLite via Prisma; prod: Postgres - see docs/ARCHITECTURE.md) ---
DATABASE_URL="file:./dev.db"

# --- Auth / session signing (generate with: openssl rand -base64 48) ---
SESSION_SECRET="dev-only-change-me-0000000000000000000000000000"
ADMIN_BOOTSTRAP_EMAIL="admin@example.org"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"

# --- Payments (mock provider in dev; real credentials stay out of Git) ---
PAYMENTS_PROVIDER="mock"
PAYMENTS_API_KEY=""
PAYMENTS_WEBHOOK_SECRET=""

# --- Email / SMS (optional, provider-agnostic) ---
EMAIL_PROVIDER=""
EMAIL_FROM="no-reply@example.org"
EMAIL_API_KEY=""
SMS_PROVIDER=""
SMS_API_KEY=""

# --- Analytics (privacy-first, self-hosted-friendly) ---
ANALYTICS_ENABLED="true"
